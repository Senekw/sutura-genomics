#!/usr/bin/env python
"""No-install launcher for the workflow-recommend CLI.

Run directly without pip install:
    python workflow/workflow-recommend "Xenium breast tumor, cell types and niches"
"""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

from workflow_recommend.cli import main  # noqa: E402

if __name__ == "__main__":
    raise SystemExit(main())
