#############################################################################
# sutura-align  -  Apptainer / Singularity definition for HPC
#############################################################################
# Two ways to build a .sif:
#
# (A) FAST - convert the already-built Docker image (recommended if you have Docker
#     locally or pull from a registry):
#
#         apptainer build sutura-align.sif docker://suturagenomics/sutura-align:1.0.0
#     or  apptainer build sutura-align.sif docker-daemon://suturagenomics/sutura-align:1.0.0
#
# (B) STANDALONE - build directly from this definition (no Docker needed). Run from the
#     module directory so the %files paths resolve:
#
#         cd integrations/nextflow
#         apptainer build --fakeroot sutura-align.sif containers/Singularity.def
#
# On HPC, most sites let you `module load apptainer` (or singularity) and build with
# --fakeroot, or you build on a workstation and `scp` the .sif to the cluster.
#############################################################################
Bootstrap: docker
From: python:3.12-slim-bookworm

%labels
    Author        Sutura Genomics
    Version       1.0.0
    Description   Distribution-routed spatial section alignment (engine + Nextflow)

%files
    # paths are relative to the build working directory (integrations/nextflow/)
    containers/requirements-container.txt   /tmp/requirements-container.txt
    engine                                  /opt/sutura/src
    assets/shared_basis.npz                 /opt/sutura/results/shared_basis.npz
    assets/arca_shared_basis.pt             /opt/sutura/results/arca_shared_basis.pt
    assets/dist_reference.npz               /opt/sutura/results/dist_reference.npz
    bin                                     /opt/sutura/integrations/nextflow/bin
    modules                                 /opt/sutura/integrations/nextflow/modules
    subworkflows                            /opt/sutura/integrations/nextflow/subworkflows
    conf                                    /opt/sutura/integrations/nextflow/conf
    main.nf                                 /opt/sutura/integrations/nextflow/main.nf
    nextflow.config                         /opt/sutura/integrations/nextflow/nextflow.config

%environment
    export SUTURA_ENGINE_ROOT=/opt/sutura
    export PATH=/opt/sutura/integrations/nextflow/bin:$PATH
    export PYTHONUNBUFFERED=1
    export OMP_NUM_THREADS=2
    export MKL_NUM_THREADS=2

%post
    export DEBIAN_FRONTEND=noninteractive
    apt-get update && apt-get install -y --no-install-recommends \
        openjdk-17-jre-headless procps curl ca-certificates bash
    rm -rf /var/lib/apt/lists/*

    pip install --no-cache-dir --upgrade pip
    pip install --no-cache-dir \
        --extra-index-url https://download.pytorch.org/whl/cpu \
        -r /tmp/requirements-container.txt

    # Nextflow (pinned) so the pipeline can run inside the container
    curl -fsSL https://github.com/nextflow-io/nextflow/releases/download/v24.10.4/nextflow-24.10.4-dist \
        -o /usr/local/bin/nextflow
    chmod +x /usr/local/bin/nextflow

    chmod +x /opt/sutura/integrations/nextflow/bin/*.py
    mkdir -p /work

%runscript
    exec sutura_align.py "$@"

%help
    Spatial section alignment engine. Run a single pair with:
        apptainer run sutura-align.sif --reference ref.h5ad --moving mov.h5ad \
            --pair-id demo --outdir out
    or drive the Nextflow pipeline (see integrations/nextflow/README.md).
