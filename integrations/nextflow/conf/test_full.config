/*
    -profile test_full : heavier DLPFC run across several donor pairs at full
    resolution. Use to validate performance/resource settings before a real batch.

        nextflow run integrations/nextflow -profile test_full,local --outdir test_full_out
*/

params {
    config_profile_name        = 'DLPFC full test'
    config_profile_description  = 'Multi-pair full-resolution DLPFC run'

    input        = "${projectDir}/assets/samplesheet_test_full.csv"
    outdir       = 'test_full_out'
    subsample    = 0
    gate_refine  = true
    on_missing   = 'skip'
}
