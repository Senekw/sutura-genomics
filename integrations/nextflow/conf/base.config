/*
    Base resource requests, keyed by process label. Values are capped by the
    params.max_* ceilings via check_max() (defined in nextflow.config), so the same
    pipeline runs on a laptop and a fat HPC node without edits. Override per site by
    editing this file or supplying a custom -c institution.config.
*/

process {
    cpus   = { check_max( 1    * task.attempt, 'cpus'   ) }
    memory = { check_max( 4.GB * task.attempt, 'memory' ) }
    time   = { check_max( 2.h  * task.attempt, 'time'   ) }

    // transient failures (exit 137 = OOM/killed, 143 = SIGTERM) get one retry with
    // more resources; anything else follows the module's own errorStrategy.
    errorStrategy = { task.exitStatus in [137, 143, 104, 134, 139] ? 'retry' : 'finish' }
    maxRetries    = 1

    withLabel: process_single {
        cpus   = { check_max( 1,                'cpus'   ) }
        memory = { check_max( 2.GB * task.attempt, 'memory' ) }
        time   = { check_max( 1.h  * task.attempt, 'time'   ) }
    }

    // alignment: PASTE2 full-resolution OT is the heavy path (~4 GB, minutes/pair);
    // the shared-basis GNN is sub-second. Size for the heavy path.
    withLabel: process_medium {
        cpus   = { check_max( 2    * task.attempt, 'cpus'   ) }
        memory = { check_max( 8.GB * task.attempt, 'memory' ) }
        time   = { check_max( 4.h  * task.attempt, 'time'   ) }
    }

    withName: SUTURA_ALIGN {
        // per-pair alignment; the report/check steps stay tiny
        cpus   = { check_max( 2    * task.attempt, 'cpus'   ) }
        memory = { check_max( 8.GB * task.attempt, 'memory' ) }
    }
}
