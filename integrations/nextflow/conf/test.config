/*
    -profile test : a small, self-contained proof-of-function run on the bundled
    DLPFC demo sections. Run from the repository root:

        nextflow run integrations/nextflow -profile test,local --outdir test_out

    Two pairs exercise both alignment routes and the report:
      * Br5292  -> auto-routes to the shared-basis GNN (in-distribution), sub-second
      * Br5292_p2 -> forced PASTE2 + gate refinement, subsampled so OT stays quick
*/

params {
    config_profile_name        = 'DLPFC demo test'
    config_profile_description  = 'Two-pair DLPFC run proving both routes + report'

    input        = "${projectDir}/assets/samplesheet_test.csv"
    outdir       = 'test_out'
    subsample    = 800        // keep the PASTE2 pair fast
    gate_order   = 'affine'
    on_missing   = 'skip'
    max_cpus     = 2
    max_memory   = '8.GB'
    max_time     = '2.h'
}
