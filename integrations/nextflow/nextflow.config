/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    sutura-align  |  Nextflow configuration
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Every knob a lab is likely to touch lives in params{} below with a documented
    default. Override on the command line (--method sutura) or in a -params-file.
    Execution environments (containers, schedulers, cloud) live in profiles{}.
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

manifest {
    name            = 'sutura-align'
    author          = 'Sutura Genomics'
    homePage        = 'https://github.com/Senekw/sutura-genomics'
    description     = 'Distribution-routed spatial section alignment as a pipeline step'
    mainScript      = 'main.nf'
    nextflowVersion = '>=22.10.0'
    version         = '1.0.0'
}

params {
    // --- I/O ---------------------------------------------------------------
    input             = null           // samplesheet CSV (required)
    outdir            = 'results'       // output directory (required)
    publish_dir_mode  = 'copy'          // copy | symlink | link
    run_name          = null            // label used in the report title

    // --- alignment knobs (defaults; per-row samplesheet values override) ---
    method            = 'auto'          // auto | sutura | paste2
    gate_refine       = false           // apply the training-free gate refinement
    gate_order        = 'affine'        // rigid | affine | quadratic
    subsample         = 0               // cap each section to N spots (0 = off)
    knn               = null            // override GNN kNN degree (null = checkpoint value)
    seed              = 0
    min_spots         = 100             // QC threshold
    output_format     = 'both'          // h5ad | csv | both

    // --- robustness --------------------------------------------------------
    on_missing        = 'skip'          // skip | fail  (missing input paths)
    strict            = false           // true = abort the run on any pair failure

    // --- engine location (auto-detected inside the container) --------------
    engine_root       = null            // repo root with src/ + results/ (null = auto)

    // --- resources (overridable per label in conf/base.config) -------------
    max_cpus          = 8
    max_memory        = '16.GB'
    max_time          = '24.h'

    // --- misc --------------------------------------------------------------
    help              = false
    tracedir          = "${params.outdir}/pipeline_info"
}

// resource labels + retry policy
includeConfig 'conf/base.config'

// -------------------------------------------------------------------------- //
//  profiles
// -------------------------------------------------------------------------- //
profiles {

    // run everything on the local machine, no container (assumes the engine env
    // is importable - e.g. the research workstation, or the .venv on PATH).
    local {
        process.executor = 'local'
        docker.enabled   = false
        singularity.enabled = false
    }

    // every process runs inside the Sutura container (recommended, portable).
    docker {
        docker.enabled   = true
        docker.runOptions = '-u $(id -u):$(id -g)'
        singularity.enabled = false
        process.container = params.container ?: 'suturagenomics/sutura-align:1.0.0'
        process.executor  = 'local'
        // engine assets are baked into the image at /opt/sutura
        env.SUTURA_ENGINE_ROOT = '/opt/sutura'
    }

    // Apptainer / Singularity for HPC where Docker is not available.
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
        process.container = params.container ?:
            'oras://docker.io/suturagenomics/sutura-align:1.0.0'
        env.SUTURA_ENGINE_ROOT = '/opt/sutura'
    }

    // SLURM scheduler (combine with singularity: -profile slurm,singularity)
    slurm {
        process.executor      = 'slurm'
        process.queue         = params.queue ?: 'general'
        process.clusterOptions = params.cluster_options ?: ''
        executor.queueSize    = 50
        executor.submitRateLimit = '10/1min'
    }

    // AWS Batch skeleton (fill in queue + bucket, then -profile cloud)
    cloud {
        process.executor = 'awsbatch'
        process.queue    = params.aws_queue ?: 'sutura-queue'
        process.container = params.container ?: 'suturagenomics/sutura-align:1.0.0'
        aws.region       = params.aws_region ?: 'us-east-1'
        workDir          = params.aws_workdir ?: 's3://sutura-work/nf'
        env.SUTURA_ENGINE_ROOT = '/opt/sutura'
    }

    // tiny built-in run on the bundled DLPFC demo (proof of function / CI)
    test {
        includeConfig 'conf/test.config'
    }

    // exhaustive DLPFC test (all downloaded folds), heavier
    test_full {
        includeConfig 'conf/test_full.config'
    }
}

// -------------------------------------------------------------------------- //
//  reporting / provenance
// -------------------------------------------------------------------------- //
timeline { enabled = true; file = "${params.tracedir}/timeline.html"; overwrite = true }
report   { enabled = true; file = "${params.tracedir}/report.html";   overwrite = true }
trace    { enabled = true; file = "${params.tracedir}/trace.txt";     overwrite = true }
dag      { enabled = true; file = "${params.tracedir}/dag.html";      overwrite = true }

// -------------------------------------------------------------------------- //
//  helper: cap a resource request at the configured maximum
// -------------------------------------------------------------------------- //
def check_max(obj, type) {
    if (type == 'memory') {
        try {
            if (obj.compareTo(params.max_memory as nextflow.util.MemoryUnit) == 1)
                return params.max_memory as nextflow.util.MemoryUnit
            return obj
        } catch (all) { return obj }
    } else if (type == 'time') {
        try {
            if (obj.compareTo(params.max_time as nextflow.util.Duration) == 1)
                return params.max_time as nextflow.util.Duration
            return obj
        } catch (all) { return obj }
    } else if (type == 'cpus') {
        try { return Math.min(obj, params.max_cpus as int) }
        catch (all) { return obj }
    }
}
